{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/thoi-tiet",
      "destination": "/thoi-tiet.html"
    },
    {
      "source": "/radio",
      "destination": "/radio.html"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,Authorization,Secure-Token" }
      ]
    }
  ]
}
