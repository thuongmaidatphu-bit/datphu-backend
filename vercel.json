{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/thoi-tiet",
      "destination": "/thoi-tiet.html"
    },
    {
      "source": "/giai-tri",
      "destination": "/giai-tri.html"
    },
    {
      "source": "/lao-dong",
      "destination": "/lao-dong.html"
    },
    {
      "source": "/sua-nha",
      "destination": "/sua-chua-nha-dien-nuoc-camera.html"
    },
    {
      "source": "/dien-nuoc-camera",
      "destination": "/sua-chua-nha-dien-nuoc-camera.html"
    },
    {
      "source": "/sua-chua",
      "destination": "/sua-chua-nha-dien-nuoc-camera.html"
    },
    {
      "source": "/do-dat",
      "destination": "/do-dat.html"
    },
    {
      "source": "/tu-thien",
      "destination": "/do-dat.html"
    },
    {
      "source": "/radio",
      "destination": "/giai-tri.html"
    },
    {
      "source": "/tam-linh",
      "destination": "/tam-linh.html"
    },
    {
      "source": "/niem-phat",
      "destination": "/tam-linh.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,DELETE,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type,Authorization,Secure-Token"
        }
      ]
    }
  ]
}