<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Đất Phú — Tìm Thợ Sửa Chữa Quanh Đây (TP. Tuy Hòa)</title>
  <link rel="apple-touch-icon" href="logo_datphu.jpg">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
          colors: {
            datphu: {
              red: '#D32027',
              navy: '#1B2A6B',
              gold: '#F59E0B'
            }
          },
          boxShadow: {
            'soft': '0 4px 20px -2px rgba(15, 23, 42, 0.06)',
            'hover': '0 10px 25px -4px rgba(27, 42, 107, 0.12)'
          }
        }
      }
    }
  </script>
  <style>
    body { background-color: #F8FAFC; -webkit-tap-highlight-color: transparent; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .detail-drawer { display: none; }
    .detail-drawer.open { display: block; }
    .modal-bg { display: none; }
    .modal-bg.open { display: flex; }
  </style>
</head>
<body class="text-slate-800 antialiased font-sans min-h-screen flex flex-col justify-between">

  <div>
    <!-- ======================== HEADER TINH GỌN, SANG TRỌNG ======================== -->
    <header class="bg-white/95 backdrop-blur-md border-b border-slate-200/80 sticky top-0 z-40 shadow-xs">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
        <!-- Logo Đất Phú chuẩn -->
        <a href="index.html" class="flex items-center gap-2.5 shrink-0">
          <img src="logo_datphu.jpg" alt="Logo Đất Phú" class="h-9 object-contain rounded">
          <div class="border-l border-slate-200 pl-2.5 leading-tight">
            <div class="text-xs sm:text-sm font-extrabold text-slate-900 flex items-center gap-1.5">
              <span>TÌM THỢ QUANH ĐÂY</span>
              <span class="text-[10px] px-2 py-0.5 bg-blue-50 text-datphu-navy rounded-full font-bold border border-blue-200">Chuẩn 6K</span>
            </div>
            <div class="text-[11px] text-slate-500 font-medium hidden sm:block">
              Định vị thực tế Tuy Hòa • Giá niêm yết công khai
            </div>
          </div>
        </a>

        <!-- Nhóm nút góc phải -->
        <div class="flex items-center gap-2">
          <a href="tho_nhan_cuoc.html" class="px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold flex items-center gap-1.5 transition" title="Màn hình nhận cuốc thực tế dành cho Thợ">
            <i class="fa-solid fa-motorcycle text-datphu-red"></i>
            <span class="hidden md:inline">Thợ Nhận Cuốc</span>
          </a>
          <a href="tel:0979991898" class="px-3.5 py-2 rounded-xl bg-datphu-red hover:bg-red-700 text-white text-xs font-bold flex items-center gap-1.5 shadow-xs transition">
            <i class="fa-solid fa-phone-volume"></i>
            <span>0979.991.898</span>
          </a>
        </div>
      </div>
    </header>

    <!-- ======================== KHUNG ĐIỀU KHIỂN GỌN GÀNG TRÊN 1 KHỐI ======================== -->
    <main class="max-w-6xl mx-auto px-4 py-5 space-y-5">

      <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-soft space-y-3.5">
        <!-- Hàng 1: Nút 1-Chạm GPS (Ưu tiên số 1) + Chọn Vị Trí + Tìm kiếm + Bán kính -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-2.5 items-center">
          <!-- Cột 1: Nút Gọi Thợ Ngay (3 cột) -->
          <div class="md:col-span-3">
            <a href="cuu_ho_20kb.html" class="w-full py-2.5 px-3 rounded-xl bg-datphu-red hover:bg-red-700 text-white font-extrabold text-xs sm:text-sm flex items-center justify-center gap-2 shadow-xs transition cursor-pointer">
              <i class="fa-solid fa-phone-volume"></i>
              <span>Gọi Thợ Ngay</span>
            </a>
            <!-- Input ẩn giữ tọa độ mặc định phục vụ tìm kiếm bán kính thợ -->
            <input type="hidden" id="userWard" value="13.0892|109.3095|86 Lê Duẩn, P.7, TP. Tuy Hòa">
          </div>

          <!-- Ô Tìm kiếm (6 cột) -->
          <div class="md:col-span-6 relative">
            <i class="fa-solid fa-magnifying-glass text-slate-400 text-xs absolute left-3.5 top-1/2 -translate-y-1/2"></i>
            <input id="kwInput" oninput="renderWorkers()" placeholder="Tìm tên thợ, mốc hoặc sự cố (điện nước, vi tính, camera, cơ khí)..." class="w-full bg-slate-50 focus:bg-white border border-slate-200 rounded-xl pl-9 pr-3.5 py-2.5 text-xs sm:text-sm font-medium text-slate-800 placeholder:text-slate-400 focus:outline-none focus:border-datphu-navy transition">
          </div>

          <!-- Chọn Bán kính (3 cột) -->
          <div class="md:col-span-3 flex items-center justify-between bg-slate-100 p-1 rounded-xl border border-slate-200/70">
            <button class="rad-btn flex-1 py-1.5 rounded-lg text-xs font-bold text-slate-600 transition" id="rad-1" onclick="setRadius(1)">1km</button>
            <button class="rad-btn act flex-1 py-1.5 rounded-lg text-xs font-bold bg-white text-datphu-navy shadow-xs transition" id="rad-3" onclick="setRadius(3)">3km</button>
            <button class="rad-btn flex-1 py-1.5 rounded-lg text-xs font-bold text-slate-600 transition" id="rad-5" onclick="setRadius(5)">5km</button>
            <button class="rad-btn flex-1 py-1.5 rounded-lg text-xs font-bold text-slate-600 transition" id="rad-10" onclick="setRadius(10)">10km</button>
          </div>
        </div>

        <!-- Hàng 2: Thanh lọc ngành nghề gọn trên 1 dòng cuộn mượt -->
        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pt-1 border-t border-slate-100">
          <button class="f-chip act shrink-0 px-3.5 py-1.5 rounded-full text-xs font-bold bg-datphu-navy text-white shadow-xs transition" onclick="setTrade('',this)">
            Tất cả thợ gần bạn
          </button>
          <button class="f-chip shrink-0 px-3.5 py-1.5 rounded-full text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition" onclick="setTrade('DIEN_NUOC',this)">
            ⚡ Điện & Nước
          </button>
          <button class="f-chip shrink-0 px-3.5 py-1.5 rounded-full text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition" onclick="setTrade('VI_TINH',this)">
            💻 Sửa Chữa Vi Tính
          </button>
          <button class="f-chip shrink-0 px-3.5 py-1.5 rounded-full text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition" onclick="setTrade('CAMERA',this)">
            📹 Camera & An Ninh
          </button>
          <button class="f-chip shrink-0 px-3.5 py-1.5 rounded-full text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition" onclick="setTrade('CHONG_THAM',this)">
            🏠 Chống thấm & Sửa nhà
          </button>
          <button class="f-chip shrink-0 px-3.5 py-1.5 rounded-full text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition" onclick="setTrade('CO_KHI',this)">
            🔩 Cơ khí sắt & Cửa
          </button>
        </div>
      </div>

      <!-- Thông báo đặt lịch: Thẻ Trạng Thái An Tâm Gọi Thợ (ẩn mặc định) -->
      <div id="replyToast" class="hidden bg-white border-2 border-emerald-500/70 rounded-2xl p-4 sm:p-5 shadow-lg shadow-emerald-500/10 text-xs sm:text-sm text-slate-800 transition-all"></div>

      <!-- Dòng trạng thái gọn nhẹ (không đóng khung rườm rà) -->
      <div class="flex items-center justify-between px-1 text-xs text-slate-500">
        <div id="radarStatus" class="font-semibold flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span>Đang quét vị trí Thợ 6K quanh bạn...</span>
        </div>
        <div class="hidden sm:flex items-center gap-1 text-[11px] text-slate-400 font-medium">
          <i class="fa-solid fa-shield-halved text-emerald-600"></i>
          <span>Xác thực Zalo OTP • Bảo hành điện tử K6</span>
        </div>
      </div>

      <!-- ======================== LƯỚI THẺ THỢ 6K THOÁNG ĐÃNG ======================== -->
      <div id="workerList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>

    </main>
  </div>

  <!-- ======================== FOOTER TỐI GIẢN ======================== -->
  <footer class="bg-white border-t border-slate-200/80 mt-10 py-5 px-4 text-xs text-slate-500">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
      <div class="font-bold text-slate-700">ĐẤT PHÚ CORE • Mạng lưới Thợ Kỹ Thuật 6K TP. Tuy Hòa, Phú Yên</div>
      <div>Hotline hỗ trợ 24/7: <b class="text-datphu-red">0979.991.898</b></div>
    </div>
  </footer>

  <!-- ======================== MODAL ĐẶT THỢ GỌN ĐẸP ======================== -->
  <div class="modal-bg fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs items-center justify-center p-4" id="dispatchModal">
    <div class="bg-white rounded-3xl max-w-md w-full p-5 sm:p-6 shadow-2xl border border-slate-100 max-h-[92vh] overflow-y-auto space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div class="flex items-center gap-3">
          <div class="relative shrink-0">
            <img id="mWorkerAvatar" src="" alt="Worker Avatar" class="w-12 h-12 rounded-2xl object-cover ring-2 ring-datphu-navy shadow-xs">
            <span class="absolute -bottom-1 -right-1 text-xs">⭐</span>
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-[10px] font-extrabold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">THỢ 6K TUY HÒA SẴN SÀNG</span>
            </div>
            <h3 id="mWorkerTitle" class="text-base font-extrabold text-slate-900 mt-0.5 leading-tight">Kết Nối Thợ Kỹ Thuật</h3>
            <div id="mWorkerSub" class="text-xs text-slate-500 mt-0.5"></div>
          </div>
        </div>
        <button onclick="closeModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center text-sm font-bold shrink-0">✕</button>
      </div>

      <!-- Bước 1: Nhập thông tin theo trình tự tự nhiên từ trên xuống dưới -->
      <div id="modalStepForm" class="space-y-3.5 text-xs">
        <!-- Khung thời gian phục vụ -->
        <div class="grid grid-cols-2 gap-2">
          <button type="button" id="mUrgentBtn" onclick="switchModalMode('URGENT')" class="p-2.5 rounded-xl border-2 border-datphu-red bg-red-50/60 text-datphu-red text-left font-bold transition">
            <div class="flex items-center gap-1.5">
              <span>🚨</span>
              <span>Cần hỗ trợ ngay</span>
            </div>
            <div class="text-[10px] font-medium text-slate-500 mt-0.5">Có mặt sau 20 – 45 phút</div>
          </button>
          <button type="button" id="mBookBtn" onclick="switchModalMode('BOOKING')" class="p-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-700 text-left font-bold transition">
            <div class="flex items-center gap-1.5">
              <span>📅</span>
              <span>Đặt lịch hẹn trước</span>
            </div>
            <div class="text-[10px] font-medium text-slate-500 mt-0.5">Chọn khung giờ phù hợp</div>
          </button>
        </div>

        <div id="mScheduleFields" style="display:none" class="pt-1">
          <label class="block font-bold text-slate-700 mb-1">Chọn Ngày & Khung giờ hẹn:</label>
          <div class="grid grid-cols-2 gap-2">
            <input type="date" id="mDate" class="px-3 py-2 rounded-xl border border-slate-200 bg-slate-50 font-semibold">
            <select id="mSlot" class="px-3 py-2 rounded-xl border border-slate-200 bg-slate-50 font-semibold">
              <option value="Sáng (08:30 - 10:00)">Sáng (08:30 – 10:00)</option>
              <option value="Trưa (10:00 - 11:30)">Trưa (10:00 – 11:30)</option>
              <option value="Chiều (14:00 - 15:30)">Chiều (14:00 – 15:30)</option>
              <option value="Chiều muộn (15:30 - 17:00)">Chiều muộn (15:30 – 17:00)</option>
            </select>
          </div>
        </div>

        <!-- 1. Họ và tên khách hàng -->
        <div>
          <label class="block font-bold text-slate-800 mb-1 flex items-center gap-1">
            <span>👤 Họ tên Cô / Chú / Anh / Chị</span>
            <span class="text-datphu-red">*</span>
          </label>
          <input id="mCustName" placeholder="Ví dụ: Gia đình Cô Lan, Chú Minh..." value="Gia đình Cô Lan" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white font-bold text-slate-900 focus:outline-none focus:border-datphu-navy text-xs sm:text-sm">
        </div>

        <!-- 2. Số điện thoại nhận Zalo OTP -->
        <div>
          <label class="block font-bold text-slate-800 mb-1 flex items-center justify-between">
            <span class="flex items-center gap-1">
              <span>📞 Số điện thoại nhận mã Zalo OTP</span>
              <span class="text-datphu-red">*</span>
            </span>
            <span class="text-[10px] font-normal text-slate-400">🔒 Ẩn danh bảo mật</span>
          </label>
          <input id="mCustPhone" type="tel" placeholder="Ví dụ: 0979991898" value="0979991898" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white font-bold text-slate-900 focus:outline-none focus:border-datphu-navy text-xs sm:text-sm">
        </div>

        <!-- 3. Địa chỉ nhà đón thợ -->
        <div>
          <label class="block font-bold text-slate-800 mb-1 flex items-center justify-between">
            <span class="flex items-center gap-1">
              <span>📍 Địa chỉ đón Thợ tại Tuy Hòa</span>
              <span class="text-datphu-red">*</span>
            </span>
            <button type="button" onclick="fillModalAddressWithGps()" class="text-[11px] font-bold text-datphu-navy hover:text-blue-700 flex items-center gap-1 bg-slate-100 hover:bg-slate-200 px-2 py-0.5 rounded-md transition">
              <i class="fa-solid fa-crosshairs text-datphu-red"></i> 🎯 Ghim GPS
            </button>
          </label>
          <input id="mCustAddress" placeholder="Số nhà, tên đường, phường ở TP. Tuy Hòa..." value="86 Lê Duẩn, Phường 7, TP. Tuy Hòa" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white font-semibold text-slate-900 focus:outline-none focus:border-datphu-navy text-xs sm:text-sm">
        </div>

        <!-- 4. Tình trạng hư hỏng cần hỗ trợ -->
        <div>
          <label class="block font-bold text-slate-800 mb-1 flex items-center gap-1">
            <span>🛠️ Tình trạng hư hỏng (để thợ mang đúng đồ nghề)</span>
          </label>
          <input id="mIssue" placeholder="Ví dụ: Máy bơm kêu to nhưng không lên nước, chập điện..." value="Kiểm tra & sửa chữa thiết bị tại nhà" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white font-medium text-slate-900 focus:outline-none focus:border-datphu-navy text-xs sm:text-sm">
        </div>

        <!-- Cam kết 3 tiêu chí an tâm Đất Phú 6K (chống boom, chống cãi vã) -->
        <div class="bg-emerald-50/80 border border-emerald-200/80 rounded-xl p-2.5 text-[11px] text-emerald-950 space-y-1">
          <div class="flex items-center gap-1.5 font-bold text-emerald-900">
            <i class="fa-solid fa-shield-halved text-emerald-600"></i>
            <span>Cam kết minh bạch 6K (Bảo vệ Khách & Thợ):</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-1 text-[10px] text-slate-600 pl-4">
            <div>✓ Khảo sát tận nơi 0đ</div>
            <div>✓ Báo giá công trước khi làm</div>
            <div>✓ Khách tự mua vật tư hoặc thợ mua hộ</div>
            <div>✓ Thợ gọi trước 30s khi xuất phát</div>
          </div>
        </div>

        <div id="mFormError" style="display:none" class="text-datphu-red font-bold text-xs"></div>

        <button id="mRequestOtpBtn" onclick="requestZaloOtpForWorker()" class="w-full py-3 rounded-xl bg-datphu-red hover:bg-red-700 text-white font-extrabold text-xs sm:text-sm shadow-md shadow-red-500/20 transition flex items-center justify-center gap-2">
          <span>🚀 Tiếp Tục • Nhận Mã Xác Thực Zalo (0đ)</span>
        </button>
      </div>

      <!-- Bước 2: Nhập mã OTP -->
      <div id="modalStepOtp" style="display:none" class="space-y-3 text-xs">
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-3 text-center">
          <div class="font-bold text-slate-800">
            Đã gửi mã OTP 4 số tới <span id="otpTargetPhone" class="text-datphu-red font-extrabold"></span>
          </div>
          <div class="text-[11px] text-slate-500 mt-0.5">
            Hiệu lực còn lại: <b id="otpTimerText" class="text-datphu-red">03:00</b>
          </div>
        </div>

        <div class="flex justify-center gap-2.5 py-1">
          <input class="w-12 h-14 text-center text-xl font-extrabold text-datphu-navy bg-slate-50 border-2 border-slate-300 rounded-xl focus:border-datphu-red focus:outline-none" id="mOtp1" maxlength="1" inputmode="numeric" oninput="moveOtpFocus(1)">
          <input class="w-12 h-14 text-center text-xl font-extrabold text-datphu-navy bg-slate-50 border-2 border-slate-300 rounded-xl focus:border-datphu-red focus:outline-none" id="mOtp2" maxlength="1" inputmode="numeric" oninput="moveOtpFocus(2)">
          <input class="w-12 h-14 text-center text-xl font-extrabold text-datphu-navy bg-slate-50 border-2 border-slate-300 rounded-xl focus:border-datphu-red focus:outline-none" id="mOtp3" maxlength="1" inputmode="numeric" oninput="moveOtpFocus(3)">
          <input class="w-12 h-14 text-center text-xl font-extrabold text-datphu-navy bg-slate-50 border-2 border-slate-300 rounded-xl focus:border-datphu-red focus:outline-none" id="mOtp4" maxlength="1" inputmode="numeric" oninput="moveOtpFocus(4)">
        </div>

        <div class="bg-slate-50 border border-dashed border-slate-300 rounded-xl p-3 text-center" id="zaloDemoBanner">
          <div id="zaloDemoText" class="text-slate-600 text-[11px]"></div>
          <button type="button" onclick="autoFillModalOtp()" class="mt-2 bg-datphu-navy text-white px-3 py-1.5 rounded-lg text-[11px] font-bold">
            ✨ Tự điền mã OTP thử nghiệm
          </button>
        </div>

        <div id="mOtpError" style="display:none" class="text-datphu-red font-bold text-center"></div>

        <button onclick="verifyOtpAndDispatchWorker()" class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs sm:text-sm shadow-sm transition">
          Xác Nhận & Kết Nối Thợ Ngay
        </button>

        <div class="flex justify-between pt-1 text-[11px] font-bold">
          <button type="button" onclick="backToModalForm()" class="text-slate-500 hover:text-slate-800">← Đổi số điện thoại</button>
          <button type="button" onclick="requestZaloOtpForWorker()" class="text-datphu-red hover:underline">Gửi lại mã OTP</button>
        </div>
      </div>
    </div>
  </div>

<script>
let currentRadius = 3;
let currentTrade = '';
let allWorkers = [];
let selectedWorker = null;
let modalMode = 'URGENT';
let latestDemoOtp = '';
let otpCountdownInterval = null;

const FALLBACK_WORKERS = [
  {
    workerCode: 'THO-01',
    fullName: 'Nguyễn Văn Tùng (Chú Tùng 6K)',
    phone: '0912345678',
    primaryTrade: 'DIEN_NUOC',
    tradeLabel: 'Điện nước & Máy bơm tăng áp',
    operatingWard: 'Phường 7, TP. Tuy Hòa',
    ratingAvg: 4.95,
    completedJobsCount: 128,
    experienceYears: 15,
    distanceKm: 0.14,
    selfPublishedInspectionFee: 0,
    baseFee: 120000,
    avatar: 'https://images.unsplash.com/photo-1540569014015-19a7be504e3a?auto=format&fit=crop&w=200&q=80',
    selfPublishedRateCard: [
      { serviceName: 'Khảo sát & kiểm tra tại nhà', priceLabel: '0đ (Miễn phí)' },
      { serviceName: 'Xử lý chập điện, nhảy CB, vòi nước', priceLabel: '120.000đ – 180.000đ' }
    ],
    vehicleInventory: [
