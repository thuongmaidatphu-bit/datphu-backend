{
  "name": "Đất Phú Master Automation Suite - 5 Kịch Bản Tự Động Hóa Thực Tế",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "datphu-master-gateway",
        "responseMode": "onReceived",
        "responseData": "{\"status\":\"ok\",\"service\":\"Đất Phú Master Suite\"}",
        "options": {}
      },
      "id": "master-webhook",
      "name": "0. Cổng Tiếp Nhận Tổng Hợp",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [160, 400],
      "webhookId": "datphu-master-gateway"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 }, "conditions": [{ "leftValue": "={{ $json.body.event || $json.body.type }}", "rightValue": "vietqr_payment", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" } },
            { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 }, "conditions": [{ "leftValue": "={{ $json.body.event || $json.body.type }}", "rightValue": "tax_invoice", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" } },
            { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 }, "conditions": [{ "leftValue": "={{ $json.body.event || $json.body.type }}", "rightValue": "devinfra_ping", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" } },
            { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 }, "conditions": [{ "leftValue": "={{ $json.body.event || $json.body.type }}", "rightValue": "ai_chat", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" } },
            { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 }, "conditions": [{ "leftValue": "={{ $json.body.event || $json.body.type }}", "rightValue": "backup_night", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" } }
          ]
        }
      },
      "id": "master-switch",
      "name": "Điều Phối 5 Kịch Bản Tự Động Hóa",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [420, 400]
    },
    {
      "parameters": {
        "chatId": "@datphu_thungan",
        "text": "=🔔 [1. VIETQR] Đã xác nhận tiền về: {{ $json.body.amount.toLocaleString('vi-VN') }} đ (Bàn: {{ $json.body.table }})",
        "additionalFields": { "parse_mode": "HTML" }
      },
      "id": "m-out-1",
      "name": "1. Xử Lý VietQR Bot",
